# Resend API key for the contact form (https://resend.com → API Keys)
# Sin esta variable, el formulario devuelve error 500 "not_configured".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# (Opcional) URL pública del sitio, para las URLs absolutas de Open Graph.
# En Vercel se detecta sola vía VERCEL_URL; defínela si usas dominio propio.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com
